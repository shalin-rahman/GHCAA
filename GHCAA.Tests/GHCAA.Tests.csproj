    <PackageReference Include="HtmlSanitizer" Version="9.2.1039" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="9.0.20" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="9.0.20" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="NUnit" Version="4.2.2" />
    <PackageReference Include="NUnit.Analyzers" Version="4.4.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
    <PackageReference Include="Moq" Version="4.20.72" />
    <PackageReference Include="FluentAssertions" Version="8.11.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="9.0.20" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="9.0.20" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="9.0.20" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="9.0.20" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="NUnit.Framework" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GHCAA.Application\GHCAA.Application.csproj" />
    <ProjectReference Include="..\GHCAA.Infrastructure\GHCAA.Infrastructure.csproj" />
    <ProjectReference Include="..\GHCAA.Domain\GHCAA.Domain.csproj" />
    <ProjectReference Include="..\GHCAA.API\GHCAA.API.csproj" />
