# ===================================================================
# GHCAA Local Development Environment Configuration
# ===================================================================

# ASP.NET Core Environment & Profile
ASPNETCORE_ENVIRONMENT=Development
ORG_PROFILE=ghc

# Database Connection (PostgreSQL Local / Dev Remote)
DATABASE_URL=
ConnectionStrings__PgSqlConnection=Host=localhost;Port=5432;Database=GHCAADB_v2;Username=postgres;Password=postgres;SslMode=Prefer;Timeout=30

# Security & Secrets (Optional in Development: JwtSigningKeyResolver generates ephemeral key if omitted)
Jwt__Key=
OtpSettings__HashKey=

# Email Services (Development fallback / Mock)
GmailSettings__Email=dev-placeholder@localhost
GmailSettings__AppPassword=dev-not-used

# SMS Service (Greenweb SMS Gateway - Optional in Dev)
SmsSettings__Token=

# CORS & Client Application (Angular Dev Server)
AppSettings__AllowedOrigins__0=http://localhost:4200
AppSettings__AllowedOrigins__1=http://localhost:4201
AppSettings__AllowedOrigins__2=http://localhost:5087
AppSettings__ClientUrl=http://localhost:4200
