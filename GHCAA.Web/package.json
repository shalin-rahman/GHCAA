{
  "name": "alumni-portal-web",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "npm run sync:docs && npm run gen:org-config && npm run gen:site-content && ng serve",
    "type-check": "npm run gen:org-config && npm run gen:site-content && tsc --noEmit -p tsconfig.app.json",
    "build": "npm run sync:docs && npm run gen:org-config && npm run gen:site-content && npm run apply-brand && npm run type-check && ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:unit": "npm run gen:org-config && npm run gen:site-content && vitest run",
    "test:coverage": "npm run gen:org-config && npm run gen:site-content && vitest run --coverage",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "sync:docs": "node scripts/sync-election-docs.mjs",
    "gen:org-config": "node scripts/generate-org-config-fallback.mjs",
    "gen:site-content": "node scripts/generate-site-content.mjs",
    "apply-brand": "node scripts/apply-brand.mjs"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@11.8.0",
  "dependencies": {
    "@angular/common": "^21.2.22",
    "@angular/compiler": "^21.2.22",
    "@angular/core": "^21.2.22",
    "@angular/forms": "^21.2.22",
    "@angular/platform-browser": "^21.2.22",
    "@angular/router": "^21.2.22",
    "@microsoft/signalr": "^10.0.0",
    "jspdf": "^4.2.0",
    "jspdf-autotable": "^5.0.7",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "undici": "^7.24.5",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@angular/build": "^21.2.22",
    "@angular/cli": "^21.2.22",
    "@angular/compiler-cli": "^21.2.22",
    "@playwright/test": "^1.59.1",
    "@types/node": "^25.5.2",
    "@vitest/browser-playwright": "^4.1.5",
    "@vitest/coverage-v8": "^4.1.11",
    "jsdom": "^27.1.0",
    "playwright": "^1.59.1",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
