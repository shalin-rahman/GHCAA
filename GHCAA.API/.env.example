# Copy this file to ".env" in the SAME folder (GHCAA.API) and fill in values.
# The file ".env" is gitignored — never commit it.
# Run the API from GHCAA.API (or ensure your working directory is GHCAA.API) so DotNetEnv finds .env
#
# Nested JSON keys use double underscores in environment variables:
#   Jwt:Key  ->  Jwt__Key

# Required for non-Development environments. Must be at least 32 characters.
Jwt__Key=

# PostgreSQL — use ONE of: full connection string OR DATABASE_URL (Render/Heroku style)
ConnectionStrings__PgSqlConnection=
# DATABASE_URL=postgres://user:password@host:5432/database

# SMTP (Gmail app password, not your normal login)
GmailSettings__Email=
GmailSettings__AppPassword=

# Optional: CORS (add each front-end origin)
# AppSettings__AllowedOrigins__0=http://localhost:4200
# AppSettings__AllowedOrigins__1=https://your-web-host.example.com

# Optional: persist DataProtection keys on disk (e.g. Linux container with a volume)
# DataProtection__KeyRingPath=/data/keys
