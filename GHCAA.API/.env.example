# Production‑ready environment template for GHCAA API
# --------------------------------------------------------
# This file is NOT committed to source control. Copy it to `.env`
# and fill in the values for each environment (dev, preprod, prod).
# Use double‑underscores (`__`) for nested JSON keys as supported by
# `DotNetEnv` (e.g. `Jwt:Key` => `Jwt__Key`).

# -----------------------------------------------------------------
# 1. Core application settings (common to all environments)
# -----------------------------------------------------------------
# ASP.NET Core environment (Development | Preprod | Production)
ASPNETCORE_ENVIRONMENT=Development   # change to Preprod or Production as needed

# -----------------------------------------------------------------
# 2. JWT signing key (minimum 32 characters, strongly random)
# ---------------------------------------------------------
# Generate a secret with: `openssl rand -base64 48`
Jwt__Key=YOUR_JWT_SIGNING_KEY_HERE

# -----------------------------------------------------------------
# 3. Database connection (PostgreSQL example)
# ------------------------------------------
# Use a full connection string or DATABASE_URL style.
# For Production you may prefer to store the connection string in a secret manager.
# Example format:
#   Host=hostname;Port=5432;Database=ghcaadb;Username=your_user;Password=your_password;SslMode=Require;Timeout=30
ConnectionStrings__PgSqlConnection=YOUR_POSTGRES_CONNECTION_STRING
# Alternatively (Heroku‑style):
# DATABASE_URL=postgres://user:password@host:5432/database

# -----------------------------------------------------------------
# 4. SMTP settings (Gmail app password example)
# ---------------------------------------------
# GmailSettings: Email address used by the app to send notifications
GmailSettings__Email=YOUR_GMAIL_ADDRESS
# GmailSettings: App‑specific password (not your normal login)
GmailSettings__AppPassword=YOUR_GMAIL_APP_PASSWORD

# -----------------------------------------------------------------
# 5. CORS – list each allowed origin for the front‑end
# ---------------------------------------------------
# Add one entry per line. Example for local dev and production host.
AppSettings__AllowedOrigins__0=http://localhost:4200
# AppSettings__AllowedOrigins__1=https://your-production-web.example.com

# -----------------------------------------------------------------
# 6. DataProtection – optional persistent key‑ring location
# --------------------------------------------------------
# Useful for multi‑instance deployments (e.g., containers). Leave empty to use the default
# DataProtection__KeyRingPath=/data/keys   # Linux path inside container
# DataProtection__KeyRingPath=C:\data\keys   # Windows path if needed

# -----------------------------------------------------------------
# 7. Feature flags or additional secrets (add as needed)
# ------------------------------------------------------
# Example:
# FeatureX__Enabled=true

# -----------------------------------------------------------------
# 8. End of file – DO NOT commit this file. Keep it in your
#    developer environment and protect it with appropriate OS permissions.
# --------------------------------------------------------
