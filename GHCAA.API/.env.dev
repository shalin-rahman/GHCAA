# Development environment configuration for GHCAA API
# ---------------------------------------------------
# Do NOT commit this file. Copy from .env.example and fill in real values.

ASPNETCORE_ENVIRONMENT=Development

# JWT signing key – replace with a secure 48‑byte base64 string
Jwt__Key=DEV_JWT_SIGNING_KEY_PLACEHOLDER

# PostgreSQL connection (local dev database)
ConnectionStrings__PgSqlConnection=Host=localhost;Port=5432;Database=ghcaadb_dev;Username=postgres;Password=postgres;SslMode=Prefer;Timeout=30
# Or use DATABASE_URL if preferred
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/ghcaadb_dev

# Gmail SMTP settings (app‑password, not your normal login)
GmailSettings__Email=dev@example.com
GmailSettings__AppPassword=DEV_GMAIL_APP_PASSWORD

# CORS – allow local Angular dev server
AppSettings__AllowedOrigins__0=http://localhost:4200
# Add more origins as needed for other dev front‑ends

# Optional DataProtection key‑ring (persist across dev restarts)
# DataProtection__KeyRingPath=C:\data\keys

# Feature flags (example)
# FeatureX__Enabled=true
