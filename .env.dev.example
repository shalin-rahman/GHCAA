# Template for .env.dev and GHCAA.API/.env.dev. Copy it, fill in the values, and never commit the copy.
# Use __ for nested keys: Jwt:Key is Jwt__Key.
# A key set to an empty value overrides appsettings.json with an empty string, so comment a key out
# rather than leave it blank.

ASPNETCORE_ENVIRONMENT=Development
# Picks profiles/<name>/. Without it the API serves the hardcoded defaults.
ORG_PROFILE=ghc

ConnectionStrings__PgSqlConnection=Host=localhost;Port=5432;Database=ghcaadb;Username=YOUR_USER;Password=YOUR_PASSWORD
# DATABASE_URL wins over the connection string above when it starts with postgres:// or postgresql://.
# DATABASE_URL=postgres://user:password@host:5432/database

# At least 32 characters. Generate with: openssl rand -base64 48
Jwt__Key=YOUR_JWT_SIGNING_KEY
OtpSettings__HashKey=YOUR_OTP_HASH_KEY

GmailSettings__Email=YOUR_GMAIL_ADDRESS
GmailSettings__AppPassword=YOUR_GMAIL_APP_PASSWORD
# Gmail is the default sender. Set Brevo where the host blocks SMTP.
# EmailSettings__Provider=Brevo
BrevoSettings__ApiKey=YOUR_BREVO_API_KEY
BrevoSettings__SenderEmail=YOUR_VERIFIED_SENDER
BrevoSettings__SenderName=YOUR_SENDER_NAME

SmsSettings__Token=YOUR_SMS_TOKEN

AppSettings__AllowedOrigins__0=http://localhost:4200
# AppSettings__AllowedOrigins__1=
# AppSettings__AllowedOrigins__2=
AppSettings__ClientUrl=http://localhost:4200
