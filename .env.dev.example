# Template for .env.dev and GHCAA.API/.env.dev. Copy it, fill in the values, and never commit the copy.
# Use __ for nested keys: Jwt:Key is Jwt__Key.
# A key set to an empty value overrides appsettings.json with an empty string, so comment a key out
# rather than leave it blank.

ASPNETCORE_ENVIRONMENT=Development
# Picks profiles/<name>/. Required: the API will not start without it.
ORG_PROFILE=ghc
# Port to listen on. Render sets it; leave it unset locally to use launchSettings.
# PORT=8080

# PgSql (default) or Sqlite.
# DatabaseProvider=PgSql

ConnectionStrings__PgSqlConnection=Host=localhost;Port=5432;Database=ghcaadb;Username=YOUR_USER;Password=YOUR_PASSWORD
# DATABASE_URL wins over the connection string above when it starts with postgres:// or postgresql://.
# DATABASE_URL=postgres://user:password@host:5432/database

# At least 32 characters. Generate with: openssl rand -base64 48
Jwt__Key=YOUR_JWT_SIGNING_KEY
OtpSettings__HashKey=YOUR_OTP_HASH_KEY

GmailSettings__Email=YOUR_GMAIL_ADDRESS
GmailSettings__AppPassword=YOUR_GMAIL_APP_PASSWORD
# Gmail is the default sender. Set Brevo where the host blocks SMTP.
# EmailSettings__Provider=Brevo
BrevoSettings__ApiKey=YOUR_BREVO_API_KEY
BrevoSettings__SenderEmail=YOUR_VERIFIED_SENDER
BrevoSettings__SenderName=YOUR_SENDER_NAME

SmsSettings__Token=YOUR_SMS_TOKEN

AppSettings__AllowedOrigins__0=http://localhost:4200
# AppSettings__AllowedOrigins__1=
# AppSettings__AllowedOrigins__2=
AppSettings__ClientUrl=http://localhost:4200
# Public address of this API. Payment gateways call back to it, and a gateway call fails without it.
# AppSettings__PublicApiBaseUrl=http://localhost:5000
# How long a step-up confirmation lasts, in minutes.
# AppSettings__StepUpTtlMinutes=30
# Overrides the portal address the profile pack gives (links in emails, ID cards, election documents).
# GeneralSettings__PortalBaseUrl=http://localhost:4200

# Usernames that always keep SuperAdmin. Add __1, __2 for more.
# AppSettings__ProtectedSuperAdmins__0=YOUR_ADMIN_USERNAME
# Where the first SuperAdmin's generated password is written. Defaults to a file in the API folder.
# AppSettings__SuperAdminBootstrapPasswordFilePath=
# Folder of real institution data to seed from instead of the profile's demo data.
# AppSettings__RealDataPath=
# true makes every account reset its password on next sign-in. Turn it off again after one boot.
# AppSettings__ForcePasswordResetOnBoot=false

# Who receives Contact Us messages. Add __1, __2 for more.
# ContactUsSettings__Recipients__0=YOUR_CONTACT_INBOX

# Local (default) keeps uploads on disk. S3 keeps them in a bucket and survives a redeploy.
# FileStorage__Provider=Local
# Root folder for Local uploads. Defaults to wwwroot for public files.
# FileStorage__BasePhysicalPath=
# FileStorage__S3__BucketName=YOUR_BUCKET
# Only for an S3-compatible service that is not AWS.
# FileStorage__S3__ServiceUrl=
# Read by the AWS SDK itself when the provider is S3.
# AWS_ACCESS_KEY_ID=YOUR_ACCESS_KEY_ID
# AWS_SECRET_ACCESS_KEY=YOUR_SECRET_ACCESS_KEY
# AWS_REGION=YOUR_REGION
